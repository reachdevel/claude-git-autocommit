{
  "name": "claude-git-autocommit",
  "version": "1.0.0",
  "description": "Auto-commit for Claude Code via Stop hook - diff-derived messages, no model call",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && mv dist/commit-from-diff.js dist/commit-from-diff.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0"
  }
}
